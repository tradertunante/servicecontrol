# PostHog - Analytics & Product telemetry
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o123.ingest.sentry.io/456

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Cron jobs
CRON_SECRET=your-cron-secret

# Training registration (optional, DO NOT fallback to SERVICE_ROLE_KEY)
TRAINING_REGISTRATION_SECRET=your-training-secret

# Better Stack (Logtail) - Log management
LOGTAIL_SOURCE_TOKEN=your-logtail-source-token

# Stripe - Billing & Subscriptions
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000
